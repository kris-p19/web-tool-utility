---
import { toolRegistry, popularToolSlugs } from '../config/registry';
import { localizedPath, messages, otherLocale, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
const home = locale === 'th' ? '/' : '/en/';
const currentPath = Astro.url.pathname;
const alternateLocale = otherLocale(locale);
const pathWithoutLocale = currentPath.replace(/^\/en\/?/, '').replace(/^\/+|\/+$/g, '');
const alternatePath = localizedPath(alternateLocale, pathWithoutLocale);

const popularTools = popularToolSlugs
  .map((slug) => toolRegistry.find((tool) => tool.slug === slug))
  .filter((tool): tool is (typeof toolRegistry)[number] => tool !== undefined);

const categoryGroups = [
  {
    id: 'thai-finance',
    icon: 'payments',
    iconColor: 'text-blue-500',
    title: t['thai-finance'],
    tools: toolRegistry.filter((tool) => tool.category === 'thai-finance')
  },
  {
    id: 'ai-dev',
    icon: 'smart_toy',
    iconColor: 'text-purple-500',
    title: t['ai-dev'],
    tools: toolRegistry.filter((tool) => tool.category === 'ai-dev')
  },
  {
    id: 'text-content',
    icon: 'edit_note',
    iconColor: 'text-emerald-500',
    title: t['text-content'],
    tools: toolRegistry.filter((tool) => tool.category === 'text-content')
  },
  {
    id: 'image-media',
    icon: 'image',
    iconColor: 'text-amber-500',
    title: t['image-media'],
    tools: toolRegistry.filter((tool) => tool.category === 'image-media')
  },
  {
    id: 'design-css',
    icon: 'palette',
    iconColor: 'text-rose-500',
    title: t['design-css'],
    tools: toolRegistry.filter((tool) => tool.category === 'design-css')
  }
];
---

<!-- Backdrop Overlay -->
<div
  class="fixed inset-0 z-50 bg-black/40 backdrop-blur-xs transition-opacity duration-300 pointer-events-none opacity-0"
  data-sidebar-backdrop
  aria-hidden="true"
></div>

<!-- Gemini-style Left Slide-in Drawer -->
<aside
  class="fixed top-0 left-0 bottom-0 z-50 flex w-80 max-w-[85vw] flex-col border-r border-slate-200/80 bg-[#f0f4f9] shadow-2xl transition-transform duration-300 ease-in-out -translate-x-full dark:border-slate-800/80 dark:bg-[#1e1f20]"
  data-sidebar-drawer
  aria-label="Navigation drawer"
>
  <!-- Top Bar: Logo & Close Button -->
  <div class="flex min-h-16 items-center justify-between px-5 border-b border-slate-200/60 dark:border-slate-800/60">
    <a
      href={home}
      class="flex items-center gap-2 text-base font-extrabold tracking-tight text-slate-900 dark:text-white"
    >
      <span
        class="grid size-8 place-items-center rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 text-xs font-extrabold text-white shadow-md shadow-blue-500/20"
        aria-hidden="true"
      >TX</span>
      <span class="flex items-center gap-1.5">
        ToolXHub
        <span class="rounded-full bg-blue-100 px-2 py-0.5 text-[0.65rem] font-bold text-blue-700 dark:bg-blue-950 dark:text-blue-300">
          Pro
        </span>
      </span>
    </a>

    <button
      type="button"
      class="grid size-9 place-items-center rounded-full text-slate-500 hover:bg-slate-200/60 hover:text-slate-800 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100 transition-colors"
      data-sidebar-close
      aria-label="ปิดเมนู"
    >
      <span class="material-symbols-outlined text-[20px]">close</span>
    </button>
  </div>

  <!-- Search in Drawer -->
  <div class="p-4 pb-2">
    <div class="relative">
      <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
        <span class="material-symbols-outlined text-[18px]">search</span>
      </span>
      <input
        type="search"
        class="w-full rounded-full border border-slate-300/80 bg-white py-2 pl-9 pr-3 text-xs text-slate-900 placeholder-slate-400 transition focus:border-blue-500 focus:bg-white focus:outline-none dark:border-slate-700/80 dark:bg-[#131314] dark:text-white dark:placeholder-slate-500"
        placeholder={locale === 'th' ? 'ค้นหาเครื่องมือ...' : 'Search tools...'}
        data-sidebar-search
      />
    </div>
  </div>

  <!-- Scrollable Tools List by Categories -->
  <div class="flex-1 overflow-y-auto px-3 py-2 space-y-4" data-sidebar-list>
    <!-- Home Navigation Item -->
    <a
      href={home}
      class:list={[
        'flex items-center gap-3 rounded-full px-3.5 py-2 text-xs font-bold transition-colors',
        currentPath === '/' || currentPath === '/en/'
          ? 'bg-blue-100 text-blue-700 dark:bg-blue-950/70 dark:text-blue-300'
          : 'text-slate-700 hover:bg-[#e3e8ee] dark:text-slate-300 dark:hover:bg-[#282a2c]'
      ]}
      data-sidebar-item
    >
      <span class="grid size-6 place-items-center rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400">
        <span class="material-symbols-outlined text-[16px]">home</span>
      </span>
      <span>{locale === 'th' ? 'หน้าแรก' : 'Home'}</span>
    </a>

    <!-- Popular Tools Section -->
    <div>
      <h3 class="flex items-center gap-1.5 px-3 pb-1 text-[0.68rem] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
        <span class="material-symbols-outlined text-[16px] text-amber-500">local_fire_department</span>
        <span>{locale === 'th' ? 'เครื่องมือยอดนิยม' : 'Popular Tools'}</span>
      </h3>
      <div class="space-y-0.5 mt-1">
        {popularTools.map((tool) => {
          const toolUrl = locale === 'th' ? `/tools/${tool.slug}/` : `/en/tools/${tool.slug}/`;
          const isActive = currentPath.includes(`/tools/${tool.slug}`);
          return (
            <a
              href={toolUrl}
              class:list={[
                'flex items-center justify-between rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors',
                isActive
                  ? 'bg-blue-100 text-blue-700 font-bold dark:bg-blue-950/70 dark:text-blue-300'
                  : 'text-slate-700 hover:bg-[#e3e8ee] dark:text-slate-300 dark:hover:bg-[#282a2c]'
              ]}
              data-sidebar-item
              data-tool-name={tool.name[locale]}
              data-tool-slug={tool.slug}
            >
              <div class="flex items-center gap-2 truncate">
                <span class="grid size-5 shrink-0 place-items-center rounded bg-slate-200/70 text-[0.6rem] font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                  {tool.icon}
                </span>
                <span class="truncate">{tool.name[locale]}</span>
              </div>
              {isActive && <span class="size-1.5 rounded-full bg-blue-600 dark:bg-blue-400 shrink-0"></span>}
            </a>
          );
        })}
      </div>
    </div>

    <!-- 5 Professional Category Groups -->
    {
      categoryGroups.map((group) => {
        const catUrl = locale === 'th' ? `/category/${group.id}/` : `/en/category/${group.id}/`;
        return (
          <div class="border-t border-slate-200/50 pt-2 dark:border-slate-800/50">
            <div class="flex items-center justify-between px-3 pb-1">
              <a
                href={catUrl}
                class="flex items-center gap-1.5 text-[0.7rem] font-bold uppercase tracking-wider text-slate-500 hover:text-blue-600 dark:text-slate-400 dark:hover:text-blue-400 transition-colors"
              >
                <span class:list={['material-symbols-outlined text-[16px]', group.iconColor]}>{group.icon}</span>
                <span>{group.title}</span>
              </a>
              <span class="rounded-full bg-slate-200/60 px-1.5 py-0.2 text-[0.6rem] font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-400">
                {group.tools.length}
              </span>
            </div>
            <div class="space-y-0.5 mt-1">
              {group.tools.map((tool) => {
                const toolUrl = locale === 'th' ? `/tools/${tool.slug}/` : `/en/tools/${tool.slug}/`;
                const isActive = currentPath.includes(`/tools/${tool.slug}`);
                return (
                  <a
                    href={toolUrl}
                    class:list={[
                      'flex items-center justify-between rounded-full px-3.5 py-1.5 text-xs font-medium transition-colors',
                      isActive
                        ? 'bg-blue-100 text-blue-700 font-bold dark:bg-blue-950/70 dark:text-blue-300'
                        : 'text-slate-700 hover:bg-[#e3e8ee] dark:text-slate-300 dark:hover:bg-[#282a2c]'
                    ]}
                    data-sidebar-item
                    data-tool-name={tool.name[locale]}
                    data-tool-slug={tool.slug}
                  >
                    <div class="flex items-center gap-2 truncate">
                      <span class="grid size-5 shrink-0 place-items-center rounded bg-slate-200/70 text-[0.6rem] font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-200">
                        {tool.icon}
                      </span>
                      <span class="truncate">{tool.name[locale]}</span>
                    </div>
                    {isActive && <span class="size-1.5 rounded-full bg-blue-600 dark:bg-blue-400 shrink-0"></span>}
                  </a>
                );
              })}
            </div>
          </div>
        );
      })
    }
  </div>

  <!-- Bottom Drawer Actions -->
  <div class="border-t border-slate-200/60 p-4 dark:border-slate-800/60 bg-[#e8edf4]/40 dark:bg-[#18191a]/40 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <a
        href={alternatePath}
        class="inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-bold text-slate-600 hover:bg-slate-200/70 dark:text-slate-300 dark:hover:bg-slate-800 transition-colors"
      >
        <span class="material-symbols-outlined text-[16px]">translate</span>
        <span>{t.languageSwitcher}</span>
      </a>
      <a
        href={locale === 'th' ? '/about/' : '/en/about/'}
        class="rounded-full px-3 py-1.5 text-xs font-bold text-slate-600 hover:bg-slate-200/70 dark:text-slate-300 dark:hover:bg-slate-800 transition-colors"
      >
        {t.about}
      </a>
    </div>

    <!-- Theme toggle -->
    <button
      type="button"
      class="grid size-8 place-items-center rounded-full text-slate-600 hover:bg-slate-200/70 dark:text-slate-300 dark:hover:bg-slate-800 transition-colors"
      data-theme-toggle
      aria-label={t.theme}
    >
      <span class="material-symbols-outlined text-[18px] dark:hidden">light_mode</span>
      <span class="material-symbols-outlined text-[18px] hidden dark:inline">dark_mode</span>
    </button>
  </div>
</aside>

<script>
  function setupSidebar() {
    const backdrop = document.querySelector<HTMLElement>('[data-sidebar-backdrop]');
    const drawer = document.querySelector<HTMLElement>('[data-sidebar-drawer]');
    const closeBtn = document.querySelector<HTMLElement>('[data-sidebar-close]');
    const searchInput = document.querySelector<HTMLInputElement>('[data-sidebar-search]');
    const toolItems = document.querySelectorAll<HTMLElement>('[data-sidebar-item]');
    const toggleButtons = document.querySelectorAll<HTMLElement>('[data-sidebar-toggle]');

    function openSidebar() {
      if (!drawer || !backdrop) return;
      drawer.classList.remove('-translate-x-full');
      drawer.classList.add('translate-x-0');
      backdrop.classList.remove('pointer-events-none', 'opacity-0');
      backdrop.classList.add('pointer-events-auto', 'opacity-100');
      document.body.style.overflow = 'hidden';
      searchInput?.focus();
    }

    function closeSidebar() {
      if (!drawer || !backdrop) return;
      drawer.classList.remove('translate-x-0');
      drawer.classList.add('-translate-x-full');
      backdrop.classList.remove('pointer-events-auto', 'opacity-100');
      backdrop.classList.add('pointer-events-none', 'opacity-0');
      document.body.style.overflow = '';
    }

    toggleButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openSidebar();
      });
    });

    closeBtn?.addEventListener('click', closeSidebar);
    backdrop?.addEventListener('click', closeSidebar);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeSidebar();
    });

    searchInput?.addEventListener('input', () => {
      const query = searchInput.value.toLowerCase().trim();
      toolItems.forEach((item) => {
        const name = (item.dataset.toolName || item.textContent || '').toLowerCase();
        const slug = (item.dataset.toolSlug || '').toLowerCase();
        if (!query || name.includes(query) || slug.includes(query)) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    });
  }

  setupSidebar();
  document.addEventListener('astro:page-load', setupSidebar);
</script>