---
import { SITE } from '../config/site';
import { otherLocale, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  path: string;
  type?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  locale,
  path,
  type = 'website',
  image = SITE.defaultOgImage,
  noindex = false,
  jsonLd = []
} = Astro.props;

const canonical = new URL(path, SITE.url).toString();
const cleanPath = path === '/' ? '' : path.replace(/^\/en\/?/, '').replace(/^\/|\/$/g, '');
const alternatePath = locale === 'th' ? (cleanPath ? `/${cleanPath}/` : '/') : `/en/${cleanPath ? `${cleanPath}/` : ''}`;
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.parentName,
    url: SITE.parentUrl,
    logo: `${SITE.parentUrl}/logo.png`
  },
  ...jsonLd
];
const serializedSchemas = schemas.map((schema) => JSON.stringify(schema).replace(/</g, '\\u003c'));
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="google-adsense-account" content={SITE.adsensePublisherId} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="th" href={new URL(locale === 'th' ? path : alternatePath, SITE.url).toString()} />
<link rel="alternate" hreflang="en" href={new URL(locale === 'en' ? path : alternatePath, SITE.url).toString()} />
<link rel="alternate" hreflang="x-default" href={new URL(locale === 'th' ? path : alternatePath, SITE.url).toString()} />
<link rel="icon" href="/icon.svg" type="image/svg+xml" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" content="#2563eb" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={locale === 'th' ? 'th_TH' : 'en_US'} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={new URL(image, SITE.url).toString()} />
<meta property="og:image:alt" content={`${SITE.name} - ${title}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, SITE.url).toString()} />
{serializedSchemas.map((schema) => <script type="application/ld+json" set:html={schema} />)}
