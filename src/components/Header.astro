---
import { messages, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
const home = locale === 'th' ? '/' : '/en/';
const category = (name: string) =>
  locale === 'th' ? `/category/${name}/` : `/en/category/${name}/`;
---

<header
  class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur-xl dark:border-slate-700/70 dark:bg-slate-950/90"
>
  <div class="container-shell flex min-h-16 items-center justify-between gap-4">
    <a
      href={home}
      class="flex min-h-11 items-center gap-2 rounded-lg text-lg font-extrabold tracking-tight text-slate-900 dark:text-white"
      aria-label={`${t.siteName} ${t.backHome}`}
    >
      <span
        class="grid size-9 place-items-center rounded-xl bg-blue-600 text-sm font-black text-white shadow-lg shadow-blue-600/25"
        aria-hidden="true">TX</span
      >
      <span>{t.siteName}</span>
    </a>
    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary navigation">
      <a
        class="btn btn-secondary min-h-11 border-0 bg-transparent px-3 shadow-none dark:bg-transparent"
        href={home}>{t.allTools}</a
      >
      <a
        class="btn btn-secondary min-h-11 border-0 bg-transparent px-3 shadow-none dark:bg-transparent"
        href={category('generators')}>{t.generators}</a
      >
      <a
        class="btn btn-secondary min-h-11 border-0 bg-transparent px-3 shadow-none dark:bg-transparent"
        href={category('converters')}>{t.converters}</a
      >
      <a
        class="btn btn-secondary min-h-11 border-0 bg-transparent px-3 shadow-none dark:bg-transparent"
        href={locale === 'th' ? '/about/' : '/en/about/'}>{t.about}</a
      >
    </nav>
    <div class="flex items-center gap-1">
      <button
        type="button"
        class="btn btn-secondary min-h-11 w-11 border-0 bg-transparent px-0 shadow-none"
        data-theme-toggle
        aria-label={t.theme}
        title={t.theme}
      >
        <svg
          class="size-5 dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"
          ></path></svg
        >
        <svg
          class="hidden size-5 dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path></svg
        >
      </button>
      <button
        type="button"
        class="btn btn-secondary min-h-11 w-11 border-0 bg-transparent px-0 shadow-none md:hidden"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.openMenu}
      >
        <svg
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg
        >
      </button>
    </div>
  </div>
  <div
    id="mobile-menu"
    class="container-shell hidden border-t border-slate-200/80 py-3 md:hidden dark:border-slate-700/70"
    data-mobile-menu
  >
    <nav class="grid gap-1" aria-label="Mobile navigation">
      <a class="btn btn-secondary justify-start border-0 bg-transparent shadow-none" href={home}
        >{t.allTools}</a
      >
      <a
        class="btn btn-secondary justify-start border-0 bg-transparent shadow-none"
        href={category('generators')}>{t.generators}</a
      >
      <a
        class="btn btn-secondary justify-start border-0 bg-transparent shadow-none"
        href={category('converters')}>{t.converters}</a
      >
      <a
        class="btn btn-secondary justify-start border-0 bg-transparent shadow-none"
        href={locale === 'th' ? '/about/' : '/en/about/'}>{t.about}</a
      >
    </nav>
  </div>
</header>
<script>
  const menuButton = document.querySelector<HTMLElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  if (menuButton && menu) {
    menuButton.addEventListener('click', () => {
      const open = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!open));
      menu.classList.toggle('hidden', open);
      menuButton.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    });
  }
</script>
