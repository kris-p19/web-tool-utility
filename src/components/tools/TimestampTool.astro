---
import { type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const labels =
  locale === 'th'
    ? {
        direction: 'ทิศทาง',
        timestampToDate: 'Timestamp → วันที่',
        dateToTimestamp: 'วันที่ → Timestamp',
        input: 'ค่า',
        convert: 'แปลง',
        now: 'ใช้เวลาปัจจุบัน',
        output: 'ผลลัพธ์',
        invalid: 'ค่าไม่ถูกต้อง'
      }
    : {
        direction: 'Direction',
        timestampToDate: 'Timestamp → Date',
        dateToTimestamp: 'Date → Timestamp',
        input: 'Value',
        convert: 'Convert',
        now: 'Use current time',
        output: 'Result',
        invalid: 'Invalid value'
      };
---

<div class="surface p-5 sm:p-7" data-timestamp-tool>
  <label class="field-label" for="timestamp-direction">{labels.direction}</label><select
    id="timestamp-direction"
    class="field-control"
    data-timestamp-direction
    ><option value="timestamp-date">{labels.timestampToDate}</option><option value="date-timestamp"
      >{labels.dateToTimestamp}</option
    ></select
  >
  <label class="field-label mt-5" for="timestamp-input">{labels.input}</label><input
    id="timestamp-input"
    class="field-control"
    data-timestamp-input
    inputmode="numeric"
  />
  <div class="mt-5 flex flex-wrap gap-2">
    <button class="btn btn-primary" type="button" data-timestamp-convert>{labels.convert}</button
    ><button class="btn btn-secondary" type="button" data-timestamp-now>{labels.now}</button>
  </div><p class="mt-4 min-h-5 text-sm text-rose-600 dark:text-rose-400" data-timestamp-status>
  </p><label class="field-label mt-4" for="timestamp-output">{labels.output}</label><output
    id="timestamp-output"
    class="field-control block min-h-12 font-mono"
    data-timestamp-output></output>
</div>
<script>
  import { formatDateTime, timestampToDate } from '../../lib/tools/date-time';

  const root = document.querySelector<HTMLElement>('[data-timestamp-tool]');
  if (root) {
    const direction = root.querySelector<HTMLSelectElement>('[data-timestamp-direction]');
    const input = root.querySelector<HTMLInputElement>('[data-timestamp-input]');
    const output = root.querySelector<HTMLElement>('[data-timestamp-output]');
    const status = root.querySelector<HTMLElement>('[data-timestamp-status]');
    const convert = () => {
      if (!input || !output || !status) return;
      try {
        const date =
          direction?.value === 'date-timestamp'
            ? new Date(input.value)
            : timestampToDate(Number(input.value));
        if (Number.isNaN(date.getTime())) throw new Error();
        output.textContent =
          direction?.value === 'date-timestamp'
            ? String(date.getTime())
            : `${formatDateTime(date, document.documentElement.lang === 'th' ? 'th' : 'en')} (${date.getTime()})`;
        status.textContent = '';
      } catch {
        output.textContent = '';
        status.textContent = 'ค่าไม่ถูกต้อง';
      }
    };
    root.querySelector('[data-timestamp-convert]')?.addEventListener('click', convert);
    direction?.addEventListener('change', convert);
    root.querySelector('[data-timestamp-now]')?.addEventListener('click', () => {
      if (input) input.value = String(Date.now());
      convert();
    });
    if (input) input.value = String(Date.now());
    convert();
  }
</script>
