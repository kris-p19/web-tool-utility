---
import { messages, type Locale } from '../../i18n';
import { AI_MODELS } from '../../lib/tools/ai-token-counter';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];

const labels =
  locale === 'th'
    ? {
        inputLabel: 'ใส่ข้อความหรือ Prompt ที่ต้องการคำนวณ Token',
        placeholder: 'พิมพ์หรือวางข้อความ Prompt หรือโค้ดที่นี่ เพื่อคำนวณจำนวน Token และประเมินราคา...',
        selectModel: 'เลือกโมเดล AI',
        tokens: 'จำนวน Tokens',
        chars: 'ตัวอักษรทั้งหมด',
        inputCost: 'ราคาประเมิน Input',
        outputCost: 'ราคาประเมิน Output',
        visualizerTitle: '🎨 การตัดชิ้นส่วน Token (Token Visualizer)',
        visualizerDesc: 'แถบสีแสดงขอบเขตของแต่ละ Token ตามที่โมเดล AI มองเห็น',
        clear: 'ล้างข้อมูล',
        sampleThai: 'ตัวอย่าง Prompt ภาษาไทย',
        sampleEng: 'ตัวอย่าง English Prompt',
        sampleCode: 'ตัวอย่าง Code / JSON',
        copied: 'คัดลอกแล้ว!'
      }
    : {
        inputLabel: 'Prompt or text to analyze for AI Tokens',
        placeholder: 'Type or paste your prompt, text, or code here to count tokens and estimate API cost...',
        selectModel: 'Select AI Model',
        tokens: 'Total Tokens',
        chars: 'Total Characters',
        inputCost: 'Estimated Input Cost',
        outputCost: 'Estimated Output Cost',
        visualizerTitle: '🎨 Token Visualizer',
        visualizerDesc: 'Color segments showing each token boundary as processed by LLMs',
        clear: 'Clear',
        sampleThai: 'Thai Sample Prompt',
        sampleEng: 'English Sample Prompt',
        sampleCode: 'Code / JSON Sample',
        copied: 'Copied!'
      };
---

<div class="surface p-5 sm:p-7" data-token-tool>
  <div class="grid gap-5">
    <!-- Model Selector & Controls -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <label class="field-label mb-0 text-xs font-bold" for="model-select">{labels.selectModel}:</label>
        <select id="model-select" class="field-control min-h-9 py-1 px-3 text-xs w-auto rounded-full" data-model-select>
          {Object.values(AI_MODELS).map((model) => (
            <option value={model.id}>
              {model.name} (${model.inputCostPer1M} / 1M)
            </option>
          ))}
        </select>
      </div>
      <div class="flex flex-wrap gap-1.5">
        <button class="btn btn-secondary min-h-8 py-1 px-3 text-xs" type="button" data-sample-thai>{labels.sampleThai}</button>
        <button class="btn btn-secondary min-h-8 py-1 px-3 text-xs" type="button" data-sample-eng>{labels.sampleEng}</button>
        <button class="btn btn-secondary min-h-8 py-1 px-3 text-xs" type="button" data-sample-code>{labels.sampleCode}</button>
        <button class="btn btn-secondary min-h-8 py-1 px-3 text-xs" type="button" data-token-clear>{labels.clear}</button>
      </div>
    </div>

    <!-- Big Metrics Cards -->
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="rounded-2xl border border-blue-200/80 bg-blue-50/60 p-4 text-center dark:border-blue-900/50 dark:bg-blue-950/30">
        <span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400">{labels.tokens}</span>
        <p class="mt-1 text-3xl font-black text-slate-900 dark:text-white" data-stat-tokens>0</p>
      </div>
      <div class="rounded-2xl border border-slate-200/80 bg-white/70 p-4 text-center dark:border-slate-800 dark:bg-slate-900/50">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">{labels.chars}</span>
        <p class="mt-1 text-3xl font-black text-slate-900 dark:text-white" data-stat-chars>0</p>
      </div>
      <div class="rounded-2xl border border-emerald-200/80 bg-emerald-50/60 p-4 text-center dark:border-emerald-900/50 dark:bg-emerald-950/30">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">{labels.inputCost}</span>
        <p class="mt-1 text-lg font-black text-emerald-800 dark:text-emerald-300" data-stat-input-cost>$0.00</p>
        <span class="text-[0.68rem] text-emerald-600 dark:text-emerald-400" data-stat-input-thb>≈ 0.00 บาท</span>
      </div>
      <div class="rounded-2xl border border-purple-200/80 bg-purple-50/60 p-4 text-center dark:border-purple-900/50 dark:bg-purple-950/30">
        <span class="text-xs font-bold uppercase tracking-wider text-purple-700 dark:text-purple-400">{labels.outputCost}</span>
        <p class="mt-1 text-lg font-black text-purple-800 dark:text-purple-300" data-stat-output-cost>$0.00</p>
        <span class="text-[0.68rem] text-purple-600 dark:text-purple-400" data-stat-output-thb>≈ 0.00 บาท</span>
      </div>
    </div>

    <!-- Input Area -->
    <div>
      <label class="field-label" for="token-input">{labels.inputLabel}</label>
      <textarea
        id="token-input"
        class="field-control min-h-48 resize-y leading-relaxed text-sm font-mono"
        data-token-input
        placeholder={labels.placeholder}
      ></textarea>
      <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
        {t.localOnly} · คำนวณแบบจำลอง BPE ในเบราว์เซอร์ ไม่มีการส่งข้อความหรือ Prompt ออกนอกเครื่อง
      </p>
    </div>

    <!-- Token Visualizer Section -->
    <div class="rounded-2xl border border-slate-200/80 bg-slate-50/50 p-4 dark:border-slate-800 dark:bg-[#18191a]/50" data-visualizer-container>
      <div class="flex items-center justify-between mb-2">
        <h3 class="text-xs font-bold text-slate-800 dark:text-slate-200">{labels.visualizerTitle}</h3>
        <span class="text-[0.68rem] text-slate-500 dark:text-slate-400">{labels.visualizerDesc}</span>
      </div>
      <div
        class="min-h-24 max-h-72 overflow-y-auto rounded-xl border border-slate-200 bg-white p-3 font-mono text-xs leading-loose dark:border-slate-800 dark:bg-[#131314] select-text break-all"
        data-visualizer-output
      >
        <span class="text-slate-400 italic">พิมพ์ข้อความด้านบนเพื่อดูชิ้นส่วน Token ที่ถูกตัดแบ่ง...</span>
      </div>
    </div>
  </div>
</div>

<script>
  import { analyzeAiTokens } from '../../lib/tools/ai-token-counter';

  const root = document.querySelector<HTMLElement>('[data-token-tool]');
  if (root) {
    const input = root.querySelector<HTMLTextAreaElement>('[data-token-input]');
    const modelSelect = root.querySelector<HTMLSelectElement>('[data-model-select]');
    const tokensEl = root.querySelector<HTMLElement>('[data-stat-tokens]');
    const charsEl = root.querySelector<HTMLElement>('[data-stat-chars]');
    const inputCostEl = root.querySelector<HTMLElement>('[data-stat-input-cost]');
    const inputThbEl = root.querySelector<HTMLElement>('[data-stat-input-thb]');
    const outputCostEl = root.querySelector<HTMLElement>('[data-stat-output-cost]');
    const outputThbEl = root.querySelector<HTMLElement>('[data-stat-output-thb]');
    const visualizerOutput = root.querySelector<HTMLElement>('[data-visualizer-output]');
    const clearBtn = root.querySelector<HTMLButtonElement>('[data-token-clear]');
    const sampleThaiBtn = root.querySelector<HTMLButtonElement>('[data-sample-thai]');
    const sampleEngBtn = root.querySelector<HTMLButtonElement>('[data-sample-eng]');
    const sampleCodeBtn = root.querySelector<HTMLButtonElement>('[data-sample-code]');

    // Alternating pastel colors for visual tokens (OpenAI style)
    const tokenBgColors = [
      'bg-indigo-100 text-indigo-900 dark:bg-indigo-950/70 dark:text-indigo-200',
      'bg-rose-100 text-rose-900 dark:bg-rose-950/70 dark:text-rose-200',
      'bg-emerald-100 text-emerald-900 dark:bg-emerald-950/70 dark:text-emerald-200',
      'bg-amber-100 text-amber-900 dark:bg-amber-950/70 dark:text-amber-200',
      'bg-cyan-100 text-cyan-900 dark:bg-cyan-950/70 dark:text-cyan-200',
      'bg-purple-100 text-purple-900 dark:bg-purple-950/70 dark:text-purple-200'
    ];

    function update() {
      if (!input || !modelSelect || !tokensEl || !charsEl || !inputCostEl || !inputThbEl || !outputCostEl || !outputThbEl || !visualizerOutput) return;

      const text = input.value;
      const modelId = modelSelect.value;
      const analysis = analyzeAiTokens(text, modelId);

      tokensEl.textContent = analysis.tokenCount.toLocaleString();
      charsEl.textContent = analysis.characterCount.toLocaleString();

      inputCostEl.textContent = analysis.inputCostUsd === 0 ? '$0.00' : `$${analysis.inputCostUsd.toFixed(6)}`;
      inputThbEl.textContent = `≈ ${analysis.inputCostThb.toFixed(4)} บาท`;

      outputCostEl.textContent = analysis.outputCostUsd === 0 ? '$0.00' : `$${analysis.outputCostUsd.toFixed(6)}`;
      outputThbEl.textContent = `≈ ${analysis.outputCostThb.toFixed(4)} บาท`;

      // Render tokens visually
      if (analysis.tokens.length === 0) {
        visualizerOutput.innerHTML = '<span class="text-slate-400 italic">พิมพ์ข้อความด้านบนเพื่อดูชิ้นส่วน Token ที่ถูกตัดแบ่ง...</span>';
      } else {
        const tokenSpans = analysis.tokens.map((token, index) => {
          const colorClass = tokenBgColors[index % tokenBgColors.length];
          const escaped = token
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/\n/g, '↵\n');
          return `<span class="inline-block px-1 py-0.5 rounded text-[0.75rem] mx-0.5 my-0.5 ${colorClass}" title="Token #${index + 1}">${escaped}</span>`;
        }).join('');
        visualizerOutput.innerHTML = tokenSpans;
      }
    }

    input?.addEventListener('input', update);
    modelSelect?.addEventListener('change', update);

    sampleThaiBtn?.addEventListener('click', () => {
      if (!input) return;
      input.value = 'สวัสดีครับ ช่วยเขียนสรุปใจความสำคัญของบทความเกี่ยวกับปัญญาประดิษฐ์ (AI) ในยุคปัจจุบันให้กระชับ เข้าใจง่าย และยกตัวอย่างการใช้งานจริง 3 ตัวอย่าง';
      update();
    });

    sampleEngBtn?.addEventListener('click', () => {
      if (!input) return;
      input.value = 'Please analyze the following dataset and provide actionable insights for improving user retention in our mobile application.';
      update();
    });

    sampleCodeBtn?.addEventListener('click', () => {
      if (!input) return;
      input.value = `{\n  "model": "gpt-4o",\n  "messages": [\n    {"role": "system", "content": "You are a helpful coding assistant."},\n    {"role": "user", "content": "Write a Python function to calculate Fibonacci numbers."}\n  ],\n  "temperature": 0.7\n}`;
      update();
    });

    clearBtn?.addEventListener('click', () => {
      if (!input) return;
      input.value = '';
      input.focus();
      update();
    });
  }
</script>