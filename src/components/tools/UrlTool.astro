---
import { type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const labels =
  locale === 'th'
    ? {
        mode: 'โหมด',
        encode: 'เข้ารหัส URL',
        decode: 'ถอดรหัส URL',
        input: 'ข้อความ',
        placeholder: 'https://example.com?q=สวัสดี',
        output: 'ผลลัพธ์',
        convert: 'แปลง',
        copy: 'คัดลอก',
        clear: 'ล้าง',
        error: 'ไม่สามารถถอดข้อมูล URL ได้'
      }
    : {
        mode: 'Mode',
        encode: 'URL encode',
        decode: 'URL decode',
        input: 'Text',
        placeholder: 'https://example.com?q=hello',
        output: 'Output',
        convert: 'Convert',
        copy: 'Copy',
        clear: 'Clear',
        error: 'Could not decode the URL'
      };
---

<div class="surface p-5 sm:p-7" data-url-tool>
  <label class="field-label" for="url-mode">{labels.mode}</label><select
    id="url-mode"
    class="field-control"
    data-url-mode
    ><option value="encode">{labels.encode}</option><option value="decode">{labels.decode}</option
    ></select
  >
  <label class="field-label mt-5" for="url-input">{labels.input}</label><textarea
    id="url-input"
    class="field-control min-h-40 resize-y font-mono text-sm"
    data-url-input
    placeholder={labels.placeholder}></textarea>
  <div class="mt-5 flex flex-wrap gap-2">
    <button class="btn btn-primary" type="button" data-url-convert>{labels.convert}</button><button
      class="btn btn-secondary"
      type="button"
      data-url-copy>{labels.copy}</button
    ><button class="btn btn-secondary" type="button" data-url-clear>{labels.clear}</button>
  </div>
  <p
    class="mt-4 min-h-5 text-sm text-rose-600 dark:text-rose-400"
    data-url-status
    aria-live="polite"
  >
  </p>
  <label class="field-label mt-4" for="url-output">{labels.output}</label><textarea
    id="url-output"
    class="field-control min-h-40 resize-y font-mono text-sm"
    data-url-output
    readonly></textarea>
</div>
<script>
  const root = document.querySelector<HTMLElement>('[data-url-tool]');
  if (root) {
    const mode = root.querySelector<HTMLSelectElement>('[data-url-mode]');
    const input = root.querySelector<HTMLTextAreaElement>('[data-url-input]');
    const output = root.querySelector<HTMLTextAreaElement>('[data-url-output]');
    const status = root.querySelector<HTMLElement>('[data-url-status]');
    const convert = () => {
      if (!input || !output || !status) return;
      try {
        output.value =
          mode?.value === 'decode'
            ? decodeURIComponent(input.value)
            : encodeURIComponent(input.value);
        status.textContent = '';
      } catch {
        output.value = '';
        status.textContent = 'ไม่สามารถถอดข้อมูล URL ได้';
      }
    };
    root.querySelector('[data-url-convert]')?.addEventListener('click', convert);
    root.querySelector('[data-url-copy]')?.addEventListener('click', async () => {
      if (output) await navigator.clipboard?.writeText(output.value);
    });
    root.querySelector('[data-url-clear]')?.addEventListener('click', () => {
      if (input) input.value = '';
      if (output) output.value = '';
    });
  }
</script>
