---
import { messages, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
const labels = locale === 'th'
  ? { length: 'ความยาวรหัสผ่าน', lengthHint: 'อย่างน้อย 8 ตัวอักษร', lowercase: 'ตัวพิมพ์เล็ก', uppercase: 'ตัวพิมพ์ใหญ่', numbers: 'ตัวเลข', symbols: 'สัญลักษณ์', generate: 'สร้างรหัสผ่านใหม่', output: 'รหัสผ่านที่สร้าง', strength: 'ความแข็งแรงโดยประมาณ', strong: 'แข็งแรง', good: 'ดี', basic: 'พื้นฐาน', clear: 'ล้าง' }
  : { length: 'Password length', lengthHint: 'At least 8 characters', lowercase: 'Lowercase letters', uppercase: 'Uppercase letters', numbers: 'Numbers', symbols: 'Symbols', generate: 'Generate new password', output: 'Generated password', strength: 'Estimated strength', strong: 'Strong', good: 'Good', basic: 'Basic', clear: 'Clear' };
---
<div class="surface p-5 sm:p-7" data-password-tool>
  <div class="grid gap-6">
    <div>
      <div class="flex items-center justify-between gap-3">
        <label class="field-label mb-0" for="password-length">{labels.length}</label>
        <output class="rounded-lg bg-blue-50 px-3 py-1 text-sm font-extrabold text-blue-700 dark:bg-blue-950/60 dark:text-blue-300" data-password-length-output>20</output>
      </div>
      <input id="password-length" class="mt-3 w-full accent-blue-600" type="range" min="8" max="64" value="20" data-password-length />
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{labels.lengthHint}</p>
    </div>
    <fieldset>
      <legend class="field-label">{locale === 'th' ? 'ตัวอักษรที่ใช้' : 'Character sets'}</legend>
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
        <label class="flex min-h-11 items-center gap-2 rounded-lg border border-slate-200 px-3 text-sm dark:border-slate-700"><input class="size-4 accent-blue-600" type="checkbox" data-password-lowercase checked />{labels.lowercase}</label>
        <label class="flex min-h-11 items-center gap-2 rounded-lg border border-slate-200 px-3 text-sm dark:border-slate-700"><input class="size-4 accent-blue-600" type="checkbox" data-password-uppercase checked />{labels.uppercase}</label>
        <label class="flex min-h-11 items-center gap-2 rounded-lg border border-slate-200 px-3 text-sm dark:border-slate-700"><input class="size-4 accent-blue-600" type="checkbox" data-password-numbers checked />{labels.numbers}</label>
        <label class="flex min-h-11 items-center gap-2 rounded-lg border border-slate-200 px-3 text-sm dark:border-slate-700"><input class="size-4 accent-blue-600" type="checkbox" data-password-symbols checked />{labels.symbols}</label>
      </div>
    </fieldset>
    <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-900">
      <label class="field-label" for="password-output">{labels.output}</label>
      <output id="password-output" class="block min-h-12 break-all font-mono text-lg font-bold tracking-wide text-slate-900 dark:text-white" data-password-output aria-live="polite"></output>
      <div class="mt-3 flex flex-wrap items-center gap-3 text-xs text-slate-500 dark:text-slate-400">
        <span>{labels.strength}: <strong data-password-strength></strong></span>
        <span data-password-entropy></span>
      </div>
    </div>
    <div class="flex flex-wrap gap-2">
      <button class="btn btn-primary" type="button" data-password-generate>{labels.generate}</button>
      <button class="btn btn-secondary" type="button" data-password-copy>{t.copy}</button>
      <button class="btn btn-secondary" type="button" data-password-clear>{labels.clear}</button>
    </div>
  </div>
</div>
<script>
  import { estimateEntropyBits, generatePassword, normalizePasswordOptions } from '../../lib/tools/password';

  const root = document.querySelector<HTMLElement>('[data-password-tool]');
  if (root) {
    const length = root.querySelector<HTMLInputElement>('[data-password-length]');
    const lengthOutput = root.querySelector<HTMLElement>('[data-password-length-output]');
    const output = root.querySelector<HTMLElement>('[data-password-output]');
    const strength = root.querySelector<HTMLElement>('[data-password-strength]');
    const entropy = root.querySelector<HTMLElement>('[data-password-entropy]');
    const generate = root.querySelector<HTMLButtonElement>('[data-password-generate]');
    const copy = root.querySelector<HTMLButtonElement>('[data-password-copy]');
    const clear = root.querySelector<HTMLButtonElement>('[data-password-clear]');
    const getOptions = () => normalizePasswordOptions({
      length: Number(length?.value ?? 20),
      lowercase: Boolean(root.querySelector<HTMLInputElement>('[data-password-lowercase]')?.checked),
      uppercase: Boolean(root.querySelector<HTMLInputElement>('[data-password-uppercase]')?.checked),
      numbers: Boolean(root.querySelector<HTMLInputElement>('[data-password-numbers]')?.checked),
      symbols: Boolean(root.querySelector<HTMLInputElement>('[data-password-symbols]')?.checked)
    });
    const refreshStrength = (options: ReturnType<typeof getOptions>) => {
      const bits = estimateEntropyBits(options);
      entropy.textContent = `${bits} bits`;
      strength.textContent = bits >= 100 ? 'แข็งแรง' : bits >= 70 ? 'ดี' : 'พื้นฐาน';
      strength.className = bits >= 100 ? 'text-emerald-600 dark:text-emerald-400' : bits >= 70 ? 'text-amber-600 dark:text-amber-400' : 'text-rose-600 dark:text-rose-400';
    };
    const generatePasswordValue = () => {
      const options = getOptions();
      const value = generatePassword(options);
      if (output) output.textContent = value;
      refreshStrength(options);
    };
    length?.addEventListener('input', () => {
      if (lengthOutput) lengthOutput.textContent = length.value;
      generatePasswordValue();
    });
    root.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((checkbox) => checkbox.addEventListener('change', generatePasswordValue));
    generate?.addEventListener('click', generatePasswordValue);
    copy?.addEventListener('click', async () => {
      if (!output || !copy) return;
      await navigator.clipboard?.writeText(output.textContent ?? '');
      copy.textContent = 'คัดลอกแล้ว';
      window.setTimeout(() => (copy.textContent = 'คัดลอก'), 1400);
    });
    clear?.addEventListener('click', () => {
      if (output) output.textContent = '';
    });
    generatePasswordValue();
  }
</script>
