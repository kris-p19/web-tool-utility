---
import { type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const labels =
  locale === 'th'
    ? {
        amount: 'จำนวนเงิน',
        output: 'ข้อความภาษาไทย',
        convert: 'แปลงง่าย',
        example: 'ตัวอย่าง: 1234.50',
        copy: 'คัดลอก'
      }
    : {
        amount: 'Amount',
        output: 'Thai text',
        convert: 'Convert',
        example: 'Example: 1234.50',
        copy: 'Copy'
      };
---

<div class="surface p-5 sm:p-7" data-baht-tool>
  <label class="field-label" for="baht-amount">{labels.amount}</label><input
    id="baht-amount"
    class="field-control"
    type="number"
    step="0.01"
    value="1234.5"
    data-baht-amount
  />
  <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">{labels.example}</p><button
    class="btn btn-primary mt-5"
    type="button"
    data-baht-convert>{labels.convert}</button
  ><label class="field-label mt-6" for="baht-output">{labels.output}</label><output
    id="baht-output"
    class="field-control block min-h-14 text-lg font-bold text-blue-700 dark:text-blue-300"
    data-baht-output></output><button class="btn btn-secondary mt-4" type="button" data-baht-copy
    >{labels.copy}</button
  >
</div>
<script>
  import { numberToThaiBaht } from '../../lib/tools/thai-baht';

  const root = document.querySelector<HTMLElement>('[data-baht-tool]');
  if (root) {
    const amount = root.querySelector<HTMLInputElement>('[data-baht-amount]');
    const output = root.querySelector<HTMLElement>('[data-baht-output]');
    const convert = () => {
      try {
        if (output) output.textContent = numberToThaiBaht(Number(amount?.value ?? 0));
      } catch {
        if (output) output.textContent = 'ตัวเลขไม่ถูกต้อง';
      }
    };
    amount?.addEventListener('input', convert);
    root.querySelector('[data-baht-convert]')?.addEventListener('click', convert);
    root.querySelector('[data-baht-copy]')?.addEventListener('click', async () => {
      if (output) await navigator.clipboard?.writeText(output.textContent ?? '');
    });
    convert();
  }
</script>
