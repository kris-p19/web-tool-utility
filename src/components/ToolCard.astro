---
import type { ToolConfig } from '../config/tools';
import { messages, type Locale } from '../i18n';

interface Props {
  tool: ToolConfig;
  locale: Locale;
  featured?: boolean;
}

const { tool, locale, featured = false } = Astro.props;
const t = messages[locale];
const href = locale === 'th' ? `/tools/${tool.slug}/` : `/en/tools/${tool.slug}/`;
const name = tool.name[locale];
const description = tool.description[locale];
---

<a
  href={href}
  class:list={[
    'group surface flex h-full flex-col p-5 transition hover:-translate-y-0.5 hover:border-blue-300 hover:shadow-lg hover:shadow-blue-600/10',
    featured && 'sm:p-6'
  ]}
  data-tool-card
  data-category={tool.category}
  data-search-text={`${name} ${description} ${tool.keywords[locale].join(' ')}`}
>
  <div class="flex items-start justify-between gap-3">
    <span
      class="grid size-11 shrink-0 place-items-center rounded-xl bg-blue-50 text-xs font-black tracking-tight text-blue-700 dark:bg-blue-950/60 dark:text-blue-300"
      aria-hidden="true">{tool.icon}</span
    >
    <span
      class="rounded-full bg-slate-100 px-2.5 py-1 text-[0.68rem] font-bold uppercase tracking-wide text-slate-600 dark:bg-slate-800 dark:text-slate-300"
      >{t[tool.category]}</span
    >
  </div>
  <h3
    class="mt-4 text-lg font-extrabold text-slate-900 group-hover:text-blue-700 dark:text-white dark:group-hover:text-blue-300"
  >
    {name}
  </h3>
  <p class="mt-2 flex-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{description}</p>
  <span
    class="mt-5 inline-flex min-h-9 items-center gap-1 text-sm font-bold text-blue-600 dark:text-blue-300"
    >{t.tryTool}<span aria-hidden="true">→</span></span
  >
</a>
