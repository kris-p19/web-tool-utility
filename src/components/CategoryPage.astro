---
import AdSlot from './AdSlot.astro';
import BaseLayout from './BaseLayout.astro';
import ToolCard from './ToolCard.astro';
import { AD_SLOT_IDS } from '../config/site';
import { getToolsByCategory, type ToolCategory } from '../config/registry';
import { messages, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  category: ToolCategory;
}

const { locale, category } = Astro.props;
const t = messages[locale];
const categoryName = category === 'generators' ? t.generators : t.converters;
const categoryDescription =
  locale === 'th'
    ? category === 'generators'
      ? 'เครื่องมือสร้างข้อมูล ไฟล์ และโค้ดที่ทำงานในเบราว์เซอร์'
      : 'เครื่องมือแปลงและจัดรูปแบบข้อมูลให้พร้อมใช้งาน'
    : category === 'generators'
      ? 'Browser-based generators for data, files, and code.'
      : 'Browser-based converters that make data easier to use.';
const path = locale === 'th' ? `/category/${category}/` : `/en/category/${category}/`;
const tools = getToolsByCategory(category);
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t.siteName,
      item: `https://tools.fintechxhub.com${locale === 'th' ? '/' : '/en/'}`
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: categoryName,
      item: `https://tools.fintechxhub.com${path}`
    }
  ]
};
---

<BaseLayout
  locale={locale}
  title={`${categoryName} | ${t.siteName}`}
  description={`${categoryName} - ${categoryDescription}`}
  path={path}
  jsonLd={[breadcrumbSchema]}
>
  <section class="container-shell py-10 sm:py-16">
    <nav class="text-sm text-slate-500 dark:text-slate-400" aria-label="Breadcrumb">
      <a class="hover:text-blue-600 dark:hover:text-blue-300" href={locale === 'th' ? '/' : '/en/'}
        >{t.siteName}</a
      ><span class="mx-2" aria-hidden="true">/</span><span aria-current="page">{categoryName}</span>
    </nav>
    <div class="mt-8 max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-blue-600 dark:text-blue-300">
        {t.categories}
      </p>
      <h1
        class="mt-3 text-4xl font-extrabold tracking-tight text-slate-950 sm:text-5xl dark:text-white"
      >
        {categoryName}
      </h1>
      <p class="mt-4 text-lg leading-8 text-slate-600 dark:text-slate-300">{categoryDescription}</p>
    </div>
    <div class="mt-8 flex flex-wrap gap-2">
      <a
        class:list={['btn', category === 'generators' ? 'btn-primary' : 'btn-secondary']}
        href={locale === 'th' ? '/category/generators/' : '/en/category/generators/'}
        >{t.generators}</a
      >
      <a
        class:list={['btn', category === 'converters' ? 'btn-primary' : 'btn-secondary']}
        href={locale === 'th' ? '/category/converters/' : '/en/category/converters/'}
        >{t.converters}</a
      >
    </div>
  </section>
  <section class="container-shell pb-12" aria-label={categoryName}>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((tool) => <ToolCard tool={tool} locale={locale} />)}
    </div>
  </section>
  <div class="container-shell">
    <AdSlot locale={locale} slotId={AD_SLOT_IDS.category} placement="in-content" />
  </div>
</BaseLayout>
