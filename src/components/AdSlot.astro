---
import { SITE } from '../config/site';
import { messages, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  slotId: string;
  placement: 'below-tool' | 'in-content' | 'sidebar';
}

const { locale, slotId, placement } = Astro.props;
const t = messages[locale];
const hasSlot = Boolean(slotId && slotId.trim());
const isSidebar = placement === 'sidebar';
---

<div class:list={['ad-slot', isSidebar ? 'hidden lg:flex' : 'my-8']} data-ad-container>
  {
    hasSlot ? (
      <ins
        class:list={['adsbygoogle', isSidebar ? 'block w-full min-w-[280px]' : 'block w-full']}
        style="display:block"
        data-ad-client={SITE.adsensePublisherId}
        data-ad-slot={slotId}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
    ) : (
      <span>{t.adPlaceholder}</span>
    )
  }
</div>
<script>
  interface ToolXHubWindow extends Window {
    adsbygoogle?: unknown[];
    __toolxhubAdLoader?: boolean;
  }

  const adsWindow = window as ToolXHubWindow;
  const loadAds = () => {
    if (adsWindow.__toolxhubAdLoader) return;
    adsWindow.__toolxhubAdLoader = true;
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${document.querySelector<HTMLElement>('ins[data-ad-client]')?.dataset.adClient ?? ''}`;
    script.addEventListener('load', () => {
      document.querySelectorAll<HTMLElement>('ins[data-ad-slot]').forEach((slot) => {
        try {
          adsWindow.adsbygoogle = adsWindow.adsbygoogle ?? [];
          adsWindow.adsbygoogle.push({});
        } catch {
          slot.closest('[data-ad-container]')?.classList.add('opacity-70');
        }
      });
    });
    document.head.appendChild(script);
  };

  if (document.querySelector('ins[data-ad-slot]')) {
    const idle =
      window.requestIdleCallback ??
      ((callback: IdleRequestCallback) => window.setTimeout(callback, 1200));
    idle(loadAds);
    ['pointerdown', 'keydown', 'scroll'].forEach((eventName) => {
      window.addEventListener(eventName, loadAds, { once: true, passive: true });
    });
  }
</script>
