---
import AdSlot from './AdSlot.astro';
import BaseLayout from './BaseLayout.astro';
import ToolCard from './ToolCard.astro';
import { AD_SLOT_IDS, SITE } from '../config/site';
import { popularToolSlugs, toolRegistry } from '../config/registry';
import { messages, type Locale } from '../i18n';
import type { ToolCategory } from '../config/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
const path = locale === 'th' ? '/' : '/en/';
const popularTools = popularToolSlugs
  .map((slug) => toolRegistry.find((tool) => tool.slug === slug))
  .filter(Boolean);

const mainCategories: ToolCategory[] = [
  'thai-finance',
  'ai-dev',
  'text-content',
  'image-media',
  'design-css'
];

const categoryIcons: Record<string, { icon: string; color: string }> = {
  'thai-finance': { icon: 'payments', color: 'text-blue-500' },
  'ai-dev': { icon: 'smart_toy', color: 'text-purple-500' },
  'text-content': { icon: 'edit_note', color: 'text-emerald-500' },
  'image-media': { icon: 'image', color: 'text-amber-500' },
  'design-css': { icon: 'palette', color: 'text-rose-500' }
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}${path}#website`,
  url: `${SITE.url}${path}`,
  name: SITE.name,
  description: t.description,
  inLanguage: locale === 'th' ? 'th' : 'en'
};
---

<BaseLayout
  locale={locale}
  title={`${t.siteName} - ${t.tagline}`}
  description={t.description}
  path={path}
  jsonLd={[websiteSchema]}
>
  <!-- Hero Section -->
  <section class="container-shell py-12 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[1.35fr_1fr] lg:items-center">
      <div>
        <span
          class="inline-flex min-h-8 items-center gap-2 rounded-full bg-blue-50 px-3.5 text-xs font-bold text-blue-700 dark:bg-blue-950/60 dark:text-blue-300"
        >
          <span class="size-1.5 rounded-full bg-blue-600 dark:bg-blue-400" aria-hidden="true"
          ></span>
          {t.alwaysFree}
        </span>
        <h1
          class="mt-4 text-4xl font-extrabold tracking-tight text-slate-950 sm:text-6xl dark:text-white"
        >
          {t.tagline}
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">
          {t.description}
        </p>
        <form class="mt-8 max-w-xl" role="search" data-tool-search-form>
          <label class="sr-only" for="home-tool-search">{t.searchLabel}</label>
          <div class="relative flex items-center">
            <input
              id="home-tool-search"
              class="field-control min-h-14 pl-12 pr-28 text-base shadow-lg shadow-blue-600/5 rounded-full"
              type="search"
              placeholder={t.searchPlaceholder}
              data-tool-search
              autocomplete="off"
            />
            <span class="pointer-events-none absolute left-4 text-slate-400 material-symbols-outlined text-[22px]">
              search
            </span>
            <button
              class="btn btn-primary absolute right-2 min-h-10 px-4 text-xs font-bold"
              type="submit">{t.search}</button
            >
          </div>
        </form>
        <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
          {t.alwaysFree} · {t.localOnly}
        </p>
      </div>

      <!-- Categories Showcase Card (Gemini style) -->
      <div class="surface relative overflow-hidden p-6 sm:p-7">
        <div
          class="absolute -right-16 -top-16 size-48 rounded-full bg-blue-500/10 blur-3xl"
          aria-hidden="true"
        >
        </div>
        <div class="relative">
          <div class="flex items-center justify-between">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400">
              {t.categories}
            </p>
            <span class="text-xs text-slate-500 dark:text-slate-400 font-bold">{toolRegistry.length} {t.toolCount}</span>
          </div>

          <div class="mt-4 grid gap-2">
            {
              mainCategories.map((catKey) => {
                const count = toolRegistry.filter((tool) => tool.category === catKey).length;
                const catUrl = locale === 'th' ? `/category/${catKey}/` : `/en/category/${catKey}/`;
                const catInfo = categoryIcons[catKey];
                return (
                  <a
                    class="flex min-h-11 items-center justify-between rounded-xl border border-slate-200/80 bg-white/70 px-3.5 py-2 transition hover:border-blue-400 dark:border-slate-800 dark:bg-slate-900/70"
                    href={catUrl}
                  >
                    <div class="flex items-center gap-2.5">
                      <span class:list={['material-symbols-outlined text-[19px]', catInfo?.color]}>
                        {catInfo?.icon || 'apps'}
                      </span>
                      <strong class="text-xs font-bold text-slate-900 dark:text-white">{t[catKey]}</strong>
                    </div>
                    <div class="flex items-center gap-2">
                      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[0.65rem] font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-400">
                        {count}
                      </span>
                      <span class="material-symbols-outlined text-xs text-blue-600 dark:text-blue-400 font-bold">
                        chevron_right
                      </span>
                    </div>
                  </a>
                );
              })
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tech News, Knowledge & Tips Feed (Portal Section) -->
  <section class="container-shell pb-12" id="tech-news-feed" aria-labelledby="news-hub-heading" data-article-hub>
    <div class="card p-6 sm:p-8 bg-gradient-to-br from-white via-blue-50/20 to-indigo-50/20 dark:from-slate-900 dark:via-blue-950/20 dark:to-slate-900 border-blue-100 dark:border-slate-800">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300 text-xs font-bold px-3 py-1 mb-2">
            <span class="size-2 rounded-full bg-blue-600 animate-pulse"></span>
            {locale === 'th' ? 'ข่าวสาร & คลังความรู้ไอที' : 'Tech News & Knowledge'}
          </span>
          <h2 id="news-hub-heading" class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
            {locale === 'th' ? 'อัปเดตทริก ความรู้ Windows, Linux, AI, Database & Office' : 'Latest Tech Tips, Linux, Windows, AI & Office Guides'}
          </h2>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-300 max-w-2xl">
            {locale === 'th'
              ? 'รวมเทคนิคแก้ปัญหา เคล็ดลับการทำงาน สรุปเทคโนโลยีใหม่ และวิธีใช้งานเครื่องมือดิจิทัลอย่างมือโปร'
              : 'Practical tips, server guides, AI prompts, Excel workflows, and technology insights.'}
          </p>
        </div>

        <div class="flex items-center gap-2">
          <a
            href="/admin/login/"
            class="text-xs font-bold text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 inline-flex items-center gap-1.5 transition"
            title={locale === 'th' ? 'ระบบผู้ดูแลระบบ (2FA)' : 'Admin CMS Login'}
          >
            <span class="material-symbols-outlined text-[17px]">shield_person</span>
            <span>{locale === 'th' ? 'เขียนบทความ' : 'Author Login'}</span>
          </a>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label="Topic categories">
        <button type="button" class="btn btn-primary min-h-8 text-xs px-3.5 py-1 inline-flex items-center gap-1.5" data-article-category="all">
          <span class="material-symbols-outlined text-[16px]">grid_view</span>
          <span>{locale === 'th' ? 'ทั้งหมด' : 'All Topics'}</span>
        </button>
        <button type="button" class="btn btn-secondary min-h-8 text-xs px-3 py-1 inline-flex items-center gap-1.5" data-article-category="windows">
          <span class="material-symbols-outlined text-[16px] text-blue-500">desktop_windows</span>
          <span>Windows</span>
        </button>
        <button type="button" class="btn btn-secondary min-h-8 text-xs px-3 py-1 inline-flex items-center gap-1.5" data-article-category="linux">
          <span class="material-symbols-outlined text-[16px] text-amber-500">terminal</span>
          <span>Linux & Server</span>
        </button>
        <button type="button" class="btn btn-secondary min-h-8 text-xs px-3 py-1 inline-flex items-center gap-1.5" data-article-category="ai">
          <span class="material-symbols-outlined text-[16px] text-purple-500">psychology</span>
          <span>AI & Prompt</span>
        </button>
        <button type="button" class="btn btn-secondary min-h-8 text-xs px-3 py-1 inline-flex items-center gap-1.5" data-article-category="office">
          <span class="material-symbols-outlined text-[16px] text-emerald-500">table_chart</span>
          <span>Office / Excel</span>
        </button>
        <button type="button" class="btn btn-secondary min-h-8 text-xs px-3 py-1 inline-flex items-center gap-1.5" data-article-category="database">
          <span class="material-symbols-outlined text-[16px] text-rose-500">database</span>
          <span>Database</span>
        </button>
        <button type="button" class="btn btn-secondary min-h-8 text-xs px-3 py-1 inline-flex items-center gap-1.5" data-article-category="gis">
          <span class="material-symbols-outlined text-[16px] text-teal-500">map</span>
          <span>GIS & Maps</span>
        </button>
        <button type="button" class="btn btn-secondary min-h-8 text-xs px-3 py-1 inline-flex items-center gap-1.5" data-article-category="design">
          <span class="material-symbols-outlined text-[16px] text-pink-500">draw</span>
          <span>Canva / Web</span>
        </button>
      </div>

      <!-- Articles Grid -->
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-article-grid>
        <!-- Card 1: Windows -->
        <article class="surface p-5 flex flex-col justify-between hover:shadow-lg hover:border-blue-300 dark:hover:border-blue-700 transition" data-category="windows">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="rounded-full bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300 text-[0.7rem] font-bold px-2.5 py-0.5 inline-flex items-center gap-1">
                <span class="material-symbols-outlined text-[14px]">desktop_windows</span> Windows
              </span>
              <time class="text-xs text-slate-500 dark:text-slate-400">2026-09-25</time>
            </div>
            <h3 class="text-base font-extrabold text-slate-900 dark:text-white leading-snug line-clamp-2">
              <a href="/articles/windows-11-essential-shortcuts/" class="hover:text-blue-600 dark:hover:text-blue-400 transition">
                15 คีย์ลัด Windows 11 ที่ช่วยประหยัดเวลาทำงานได้ 2 เท่า
              </a>
            </h3>
            <p class="mt-2 text-xs leading-5 text-slate-600 dark:text-slate-300 line-clamp-3">
              รวมคีย์ลัดสำหรับ Snap Layouts, Virtual Desktops, Clipboard History และ Voice Typing ที่คนทำงานยุคใหม่ต้องรู้
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">ToolXHub Tech Team</span>
            <a href="/articles/windows-11-essential-shortcuts/" class="text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline inline-flex items-center gap-0.5">
              <span>อ่านต่อ</span>
              <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
            </a>
          </div>
        </article>

        <!-- Card 2: Office / Excel -->
        <article class="surface p-5 flex flex-col justify-between hover:shadow-lg hover:border-blue-300 dark:hover:border-blue-700 transition" data-category="office">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 text-[0.7rem] font-bold px-2.5 py-0.5 inline-flex items-center gap-1">
                <span class="material-symbols-outlined text-[14px]">table_chart</span> Office / Excel
              </span>
              <time class="text-xs text-slate-500 dark:text-slate-400">2026-09-25</time>
            </div>
            <h3 class="text-base font-extrabold text-slate-900 dark:text-white leading-snug line-clamp-2">
              <a href="/articles/excel-xlookup-tutorial/" class="hover:text-blue-600 dark:hover:text-blue-400 transition">
                วิธีใช้ XLOOKUP ใน Excel ฉบับจับมือทำ บอกลา VLOOKUP ตลอดกาล
              </a>
            </h3>
            <p class="mt-2 text-xs leading-5 text-slate-600 dark:text-slate-300 line-clamp-3">
              ทำความรู้จัก XLOOKUP ฟังก์ชันค้นหาข้อมูลที่ฉลาดที่สุด ค้นหาจากขวาไปซ้ายได้ คืนค่าหลายคอลัมน์พร้อมกัน และไม่ต้องกลัวแทรกแถว
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">ToolXHub Data Pro</span>
            <a href="/articles/excel-xlookup-tutorial/" class="text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline inline-flex items-center gap-0.5">
              <span>อ่านต่อ</span>
              <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
            </a>
          </div>
        </article>

        <!-- Card 3: AI -->
        <article class="surface p-5 flex flex-col justify-between hover:shadow-lg hover:border-blue-300 dark:hover:border-blue-700 transition" data-category="ai">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="rounded-full bg-purple-100 text-purple-800 dark:bg-purple-950 dark:text-purple-300 text-[0.7rem] font-bold px-2.5 py-0.5 inline-flex items-center gap-1">
                <span class="material-symbols-outlined text-[14px]">psychology</span> AI & Prompt
              </span>
              <time class="text-xs text-slate-500 dark:text-slate-400">2026-09-25</time>
            </div>
            <h3 class="text-base font-extrabold text-slate-900 dark:text-white leading-snug line-clamp-2">
              <a href="/articles/ai-prompt-engineering-guide/" class="hover:text-blue-600 dark:hover:text-blue-400 transition">
                เทคนิคเขียน Prompt AI (ChatGPT & Claude & Gemini) ให้ได้คำตอบตรงใจ 100%
              </a>
            </h3>
            <p class="mt-2 text-xs leading-5 text-slate-600 dark:text-slate-300 line-clamp-3">
              สูตรโครงสร้าง RTCO (Role, Task, Context, Output) สำหรับสั่งงาน AI พร้อมตัวอย่างการประยุกต์ใช้งานจริงด้านเอกสารและวิเคราะห์ข้อมูล
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">AI Specialist</span>
            <a href="/articles/ai-prompt-engineering-guide/" class="text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline inline-flex items-center gap-0.5">
              <span>อ่านต่อ</span>
              <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Popular Tools Section -->
  <section class="container-shell pb-8" aria-labelledby="popular-heading">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-blue-600 dark:text-blue-400">
          {t.latest}
        </p>
        <h2
          id="popular-heading"
          class="mt-2 text-2xl font-extrabold text-slate-950 sm:text-3xl dark:text-white"
        >
          {t.popularTools}
        </h2>
      </div>
      <button
        type="button"
        class="hidden min-h-11 items-center gap-1 text-sm font-bold text-blue-600 hover:underline dark:text-blue-400 sm:inline-flex cursor-pointer"
        data-sidebar-toggle
      >
        <span class="material-symbols-outlined text-[18px]">menu_open</span>
        <span>{t.viewAll}</span>
      </button>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {popularTools.map((tool) => tool && <ToolCard tool={tool} locale={locale} featured />)}
    </div>
  </section>

  <!-- All Tools Section -->
  <section class="container-shell py-12" aria-labelledby="all-tools-heading">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-blue-600 dark:text-blue-400">
          {t.allTools}
        </p>
        <h2
          id="all-tools-heading"
          class="mt-2 text-2xl font-extrabold text-slate-950 sm:text-3xl dark:text-white"
        >
          {locale === 'th' ? 'ค้นหาเครื่องมือที่ต้องการ' : 'Find the tool you need'}
        </h2>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap gap-1.5" role="group" aria-label={t.categories}>
        <button class="btn btn-primary min-h-8 text-xs py-1 px-3 inline-flex items-center gap-1" type="button" data-category-filter="all">
          <span class="material-symbols-outlined text-[15px]">apps</span>
          <span>{t.allTools}</span>
        </button>
        {
          mainCategories.map((catKey) => {
            const catInfo = categoryIcons[catKey];
            return (
              <button class="btn btn-secondary min-h-8 text-xs py-1 px-3 inline-flex items-center gap-1" type="button" data-category-filter={catKey}>
                <span class:list={['material-symbols-outlined text-[15px]', catInfo?.color]}>
                  {catInfo?.icon || 'apps'}
                </span>
                <span>{t[catKey]}</span>
              </button>
            );
          })
        }
      </div>
    </div>
    <p class="mt-5 text-sm text-slate-500 dark:text-slate-400" data-search-count></p>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-tool-grid>
      {toolRegistry.map((tool) => <ToolCard tool={tool} locale={locale} />)}
    </div>
    <div class="surface mt-6 p-8 text-center" data-no-results hidden>
      <h3 class="text-lg font-extrabold text-slate-900 dark:text-white">{t.noResults}</h3>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{t.noResultsHint}</p>
    </div>
  </section>

  <div class="container-shell">
    <AdSlot locale={locale} slotId={AD_SLOT_IDS.home} placement="in-content" />
  </div>

  <!-- 3 Features Pillars -->
  <section
    class="container-shell my-16 grid gap-6 sm:grid-cols-3"
    aria-label="Features and Privacy"
  >
    <div class="surface p-5">
      <span class="material-symbols-outlined text-emerald-600 text-[28px]">offline_bolt</span>
      <h2 class="mt-3 font-extrabold">{t.localOnly}</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{t.description}</p>
    </div>
    <div class="surface p-5">
      <span class="material-symbols-outlined text-blue-600 text-[28px]">verified</span>
      <h2 class="mt-3 font-extrabold">{t.alwaysFree}</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{t.tagline}</p>
    </div>
    <div class="surface p-5">
      <span class="material-symbols-outlined text-purple-600 text-[28px]">shield</span>
      <h2 class="mt-3 font-extrabold">{t.privacyByDesign}</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{t.localOnly}</p>
    </div>
  </section>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-tool-search]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-tool-card]')];
  const count = document.querySelector<HTMLElement>('[data-search-count]');
  const noResults = document.querySelector<HTMLElement>('[data-no-results]');
  const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-category-filter]')];
  let category = 'all';

  const updateTools = () => {
    const query = search?.value.trim().toLowerCase() ?? '';
    let visible = 0;
    cards.forEach((card) => {
      const matchesText = !query || (card.dataset.searchText ?? '').toLowerCase().includes(query);
      const matchesCategory =
        category === 'all' ||
        card.dataset.category === category ||
        card.querySelector('[data-category]')?.getAttribute('data-category') === category;
      card.hidden = !(matchesText && matchesCategory);
      if (!card.hidden) visible += 1;
    });
    if (count)
      count.textContent =
        query || category !== 'all'
          ? `${visible} ${document.documentElement.lang === 'th' ? 'เครื่องมือ' : 'tools'}`
          : '';
    if (noResults) noResults.hidden = visible !== 0;
  };

  search?.addEventListener('input', updateTools);
  filterButtons.forEach((button) =>
    button.addEventListener('click', () => {
      category = button.dataset.categoryFilter ?? 'all';
      filterButtons.forEach((item) => item.classList.toggle('btn-primary', item === button));
      filterButtons.forEach((item) => item.classList.toggle('btn-secondary', item !== button));
      updateTools();
    })
  );
  document
    .querySelector<HTMLFormElement>('[data-tool-search-form]')
    ?.addEventListener('submit', (event) => {
      event.preventDefault();
      updateTools();
      document
        .querySelector('#all-tools-heading')
        ?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

  // Articles dynamic fetching & filtering
  const articleCategoryButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-article-category]')];
  const articleGrid = document.querySelector<HTMLElement>('[data-article-grid]');
  let activeArticleCategory = 'all';

  const filterArticleCards = () => {
    const articleCards = [...document.querySelectorAll<HTMLElement>('[data-article-grid] > article')];
    articleCards.forEach((card) => {
      const cat = card.dataset.category ?? '';
      card.hidden = !(activeArticleCategory === 'all' || cat === activeArticleCategory);
    });
  };

  articleCategoryButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeArticleCategory = btn.dataset.articleCategory ?? 'all';
      articleCategoryButtons.forEach((item) => {
        item.classList.toggle('btn-primary', item === btn);
        item.classList.toggle('btn-secondary', item !== btn);
      });
      filterArticleCards();
    });
  });

  const categoryBadgeMap: Record<string, { label: string; icon: string; bg: string }> = {
    windows: { label: 'Windows', icon: 'desktop_windows', bg: 'bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300' },
    linux: { label: 'Linux & Server', icon: 'terminal', bg: 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300' },
    ai: { label: 'AI & Prompt', icon: 'psychology', bg: 'bg-purple-100 text-purple-800 dark:bg-purple-950 dark:text-purple-300' },
    office: { label: 'Office / Excel', icon: 'table_chart', bg: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' },
    database: { label: 'Database', icon: 'database', bg: 'bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300' },
    gis: { label: 'GIS & Maps', icon: 'map', bg: 'bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300' },
    design: { label: 'Canva / Web', icon: 'draw', bg: 'bg-pink-100 text-pink-800 dark:bg-pink-950 dark:text-pink-300' }
  };

  fetch('/api/articles')
    .then((res) => (res.ok ? res.json() : null))
    .then((data: any) => {
      if (!data || !Array.isArray(data.articles) || data.articles.length === 0 || !articleGrid) return;
      articleGrid.innerHTML = data.articles
        .map((art: any) => {
          const catInfo = categoryBadgeMap[art.category] ?? {
            label: art.category || 'Tech',
            icon: 'article',
            bg: 'bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-300'
          };
          const dateStr = art.created_at ? String(art.created_at).split(' ')[0] : '2026-09-25';
          return `
            <article class="surface p-5 flex flex-col justify-between hover:shadow-lg hover:border-blue-300 dark:hover:border-blue-700 transition" data-category="${art.category || 'tech'}">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="rounded-full ${catInfo.bg} text-[0.7rem] font-bold px-2.5 py-0.5 inline-flex items-center gap-1">
                    <span class="material-symbols-outlined text-[14px]">${catInfo.icon}</span>
                    <span>${catInfo.label}</span>
                  </span>
                  <time class="text-xs text-slate-500 dark:text-slate-400">${dateStr}</time>
                </div>
                <h3 class="text-base font-extrabold text-slate-900 dark:text-white leading-snug line-clamp-2">
                  <a href="/articles/${encodeURIComponent(art.slug)}/" class="hover:text-blue-600 dark:hover:text-blue-400 transition">
                    ${art.title}
                  </a>
                </h3>
                <p class="mt-2 text-xs leading-5 text-slate-600 dark:text-slate-300 line-clamp-3">
                  ${art.summary || ''}
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">${art.author || 'Admin'}</span>
                <a href="/articles/${encodeURIComponent(art.slug)}/" class="text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline inline-flex items-center gap-0.5">
                  <span>${document.documentElement.lang === 'th' ? 'อ่านต่อ' : 'Read more'}</span>
                  <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                </a>
              </div>
            </article>
          `;
        })
        .join('');
      filterArticleCards();
    })
    .catch(() => {});
</script>
