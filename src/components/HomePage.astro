---
import AdSlot from './AdSlot.astro';
import BaseLayout from './BaseLayout.astro';
import ToolCard from './ToolCard.astro';
import { AD_SLOT_IDS, SITE } from '../config/site';
import { popularToolSlugs, toolRegistry } from '../config/registry';
import { messages, type Locale } from '../i18n';
import type { ToolCategory } from '../config/tools';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
const path = locale === 'th' ? '/' : '/en/';
const popularTools = popularToolSlugs
  .map((slug) => toolRegistry.find((tool) => tool.slug === slug))
  .filter(Boolean);

const mainCategories: ToolCategory[] = [
  'thai-finance',
  'ai-dev',
  'text-content',
  'image-media',
  'design-css'
];

const categoryIcons: Record<string, string> = {
  'thai-finance': '🇹🇭',
  'ai-dev': '🤖',
  'text-content': '📝',
  'image-media': '🖼️',
  'design-css': '🎨'
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}${path}#website`,
  url: `${SITE.url}${path}`,
  name: SITE.name,
  description: t.description,
  inLanguage: locale === 'th' ? 'th' : 'en'
};
---

<BaseLayout
  locale={locale}
  title={`${t.siteName} - ${t.tagline}`}
  description={t.description}
  path={path}
  jsonLd={[websiteSchema]}
>
  <section class="container-shell py-12 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[1.35fr_1fr] lg:items-center">
      <div>
        <span
          class="inline-flex min-h-8 items-center gap-2 rounded-full bg-blue-50 px-3.5 text-xs font-bold text-blue-700 dark:bg-blue-950/60 dark:text-blue-300"
        >
          <span class="size-1.5 rounded-full bg-blue-600 dark:bg-blue-400" aria-hidden="true"
          ></span>
          {t.alwaysFree}
        </span>
        <h1
          class="mt-4 text-4xl font-extrabold tracking-tight text-slate-950 sm:text-6xl dark:text-white"
        >
          {t.tagline}
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">
          {t.description}
        </p>
        <form class="mt-8 max-w-xl" role="search" data-tool-search-form>
          <label class="sr-only" for="home-tool-search">{t.searchLabel}</label>
          <div class="relative flex items-center">
            <input
              id="home-tool-search"
              class="field-control min-h-14 pl-12 pr-28 text-base shadow-lg shadow-blue-600/5 rounded-full"
              type="search"
              placeholder={t.searchPlaceholder}
              data-tool-search
              autocomplete="off"
            />
            <svg
              class="pointer-events-none absolute left-4 size-5 text-slate-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg
            >
            <button
              class="btn btn-primary absolute right-2 min-h-10 px-4 text-xs font-bold"
              type="submit">{t.search}</button
            >
          </div>
        </form>
        <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
          {t.alwaysFree} · {t.localOnly}
        </p>
      </div>

      <!-- Categories Showcase Card (Gemini style) -->
      <div class="surface relative overflow-hidden p-6 sm:p-7">
        <div
          class="absolute -right-16 -top-16 size-48 rounded-full bg-blue-500/10 blur-3xl"
          aria-hidden="true"
        >
        </div>
        <div class="relative">
          <div class="flex items-center justify-between">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400">
              {t.categories}
            </p>
            <span class="text-xs text-slate-500 dark:text-slate-400 font-bold">{toolRegistry.length} {t.toolCount}</span>
          </div>

          <div class="mt-4 grid gap-2">
            {
              mainCategories.map((catKey) => {
                const count = toolRegistry.filter((tool) => tool.category === catKey).length;
                const catUrl = locale === 'th' ? `/category/${catKey}/` : `/en/category/${catKey}/`;
                return (
                  <a
                    class="flex min-h-11 items-center justify-between rounded-xl border border-slate-200/80 bg-white/70 px-3.5 py-2 transition hover:border-blue-400 dark:border-slate-800 dark:bg-slate-900/70"
                    href={catUrl}
                  >
                    <div class="flex items-center gap-2.5">
                      <span class="text-sm">{categoryIcons[catKey]}</span>
                      <strong class="text-xs font-bold text-slate-900 dark:text-white">{t[catKey]}</strong>
                    </div>
                    <div class="flex items-center gap-2">
                      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[0.65rem] font-bold text-slate-600 dark:bg-slate-800 dark:text-slate-400">
                        {count}
                      </span>
                      <span class="text-xs text-blue-600 dark:text-blue-400 font-bold" aria-hidden="true">→</span>
                    </div>
                  </a>
                );
              })
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-shell pb-8" aria-labelledby="popular-heading">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-blue-600 dark:text-blue-400">
          {t.latest}
        </p>
        <h2
          id="popular-heading"
          class="mt-2 text-2xl font-extrabold text-slate-950 sm:text-3xl dark:text-white"
        >
          {t.popularTools}
        </h2>
      </div>
      <button
        type="button"
        class="hidden min-h-11 items-center text-sm font-bold text-blue-600 hover:underline dark:text-blue-400 sm:inline-flex cursor-pointer"
        data-sidebar-toggle
      >
        {t.viewAll} (☰)
      </button>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {popularTools.map((tool) => tool && <ToolCard tool={tool} locale={locale} featured />)}
    </div>
  </section>

  <section class="container-shell py-12" aria-labelledby="all-tools-heading">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-blue-600 dark:text-blue-400">
          {t.allTools}
        </p>
        <h2
          id="all-tools-heading"
          class="mt-2 text-2xl font-extrabold text-slate-950 sm:text-3xl dark:text-white"
        >
          {locale === 'th' ? 'ค้นหาเครื่องมือที่ต้องการ' : 'Find the tool you need'}
        </h2>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap gap-1.5" role="group" aria-label={t.categories}>
        <button class="btn btn-primary min-h-8 text-xs py-1 px-3" type="button" data-category-filter="all">
          {t.allTools}
        </button>
        {
          mainCategories.map((catKey) => (
            <button class="btn btn-secondary min-h-8 text-xs py-1 px-3" type="button" data-category-filter={catKey}>
              {categoryIcons[catKey]} {t[catKey]}
            </button>
          ))
        }
      </div>
    </div>
    <p class="mt-5 text-sm text-slate-500 dark:text-slate-400" data-search-count></p>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-tool-grid>
      {toolRegistry.map((tool) => <ToolCard tool={tool} locale={locale} />)}
    </div>
    <div class="surface mt-6 p-8 text-center" data-no-results hidden>
      <h3 class="text-lg font-extrabold text-slate-900 dark:text-white">{t.noResults}</h3>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{t.noResultsHint}</p>
    </div>
  </section>

  <div class="container-shell">
    <AdSlot locale={locale} slotId={AD_SLOT_IDS.home} placement="in-content" />
  </div>

  <section
    class="container-shell my-16 grid gap-6 sm:grid-cols-3"
    aria-label="Features and Privacy"
  >
    <div class="surface p-5">
      <span class="text-sm font-extrabold text-blue-600 dark:text-blue-400">01</span>
      <h2 class="mt-3 font-extrabold">{t.localOnly}</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{t.description}</p>
    </div>
    <div class="surface p-5">
      <span class="text-sm font-extrabold text-blue-600 dark:text-blue-400">02</span>
      <h2 class="mt-3 font-extrabold">{t.alwaysFree}</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{t.tagline}</p>
    </div>
    <div class="surface p-5">
      <span class="text-sm font-extrabold text-blue-600 dark:text-blue-400">03</span>
      <h2 class="mt-3 font-extrabold">{t.privacyByDesign}</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{t.localOnly}</p>
    </div>
  </section>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-tool-search]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-tool-card]')];
  const count = document.querySelector<HTMLElement>('[data-search-count]');
  const noResults = document.querySelector<HTMLElement>('[data-no-results]');
  const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-category-filter]')];
  let category = 'all';

  const updateTools = () => {
    const query = search?.value.trim().toLowerCase() ?? '';
    let visible = 0;
    cards.forEach((card) => {
      const matchesText = !query || (card.dataset.searchText ?? '').toLowerCase().includes(query);
      const matchesCategory =
        category === 'all' ||
        card.dataset.category === category ||
        card.querySelector('[data-category]')?.getAttribute('data-category') === category;
      card.hidden = !(matchesText && matchesCategory);
      if (!card.hidden) visible += 1;
    });
    if (count)
      count.textContent =
        query || category !== 'all'
          ? `${visible} ${document.documentElement.lang === 'th' ? 'เครื่องมือ' : 'tools'}`
          : '';
    if (noResults) noResults.hidden = visible !== 0;
  };

  search?.addEventListener('input', updateTools);
  filterButtons.forEach((button) =>
    button.addEventListener('click', () => {
      category = button.dataset.categoryFilter ?? 'all';
      filterButtons.forEach((item) => item.classList.toggle('btn-primary', item === button));
      filterButtons.forEach((item) => item.classList.toggle('btn-secondary', item !== button));
      updateTools();
    })
  );
  document
    .querySelector<HTMLFormElement>('[data-tool-search-form]')
    ?.addEventListener('submit', (event) => {
      event.preventDefault();
      updateTools();
      document
        .querySelector('#all-tools-heading')
        ?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
</script>