---
import AdSlot from './AdSlot.astro';
import BaseLayout from './BaseLayout.astro';
import { AD_SLOT_IDS, SITE } from '../config/site';
import { messages, type Locale } from '../i18n';

type PageKind = 'about' | 'contact' | 'privacy-policy' | 'terms';

interface Props {
  kind: PageKind;
  locale: Locale;
}

const { kind, locale } = Astro.props;
const t = messages[locale];
const path = locale === 'th' ? `/${kind}/` : `/en/${kind}/`;

