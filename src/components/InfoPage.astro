  '@context': 'https://schema.org',
  '@type': kind === 'contact' ? 'ContactPage' : 'WebPage',
  name: page.title,
  url: `${SITE.url}${path}`,
  description: page.description,
  isPartOf: { '@id': `${SITE.url}/#website` }
};
---

<BaseLayout
  locale={locale}
  title={`${page.title} | ${t.siteName}`}
  description={page.description}
  path={path}
  jsonLd={[schema]}
>
  <article class="container-shell max-w-4xl py-10 sm:py-16">
    <nav class="text-sm text-slate-500 dark:text-slate-400 flex items-center gap-1.5" aria-label="Breadcrumb">
      <a class="hover:text-blue-600 dark:hover:text-blue-300" href={locale === 'th' ? '/' : '/en/'}>
        {t.siteName}
      </a>
      <span class="material-symbols-outlined text-[14px] text-slate-400">chevron_right</span>
      <span aria-current="page" class="font-semibold text-slate-700 dark:text-slate-300">{page.title}</span>
    </nav>
    <header class="mt-8">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600 dark:text-blue-400">
        ToolXHub Legal & Compliance
      </p>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl dark:text-white">
        {page.title}
      </h1>
      <p class="mt-4 text-base leading-7 text-slate-600 dark:text-slate-300">
        {page.description}
      </p>
    </header>
    <div class="prose-copy mt-8 space-y-4 max-w-3xl text-slate-700 dark:text-slate-200">
      {page.body.map((paragraph) => (
        <p class="text-sm sm:text-base leading-7 text-slate-700 dark:text-slate-300 bg-white/60 dark:bg-slate-900/40 p-4 rounded-xl border border-slate-200/70 dark:border-slate-800/70">
          {paragraph}
        </p>
      ))}
      {
        kind === 'contact' && (
          <div class="surface mt-8 p-6 rounded-2xl border border-blue-100 dark:border-slate-800">
            <h2 class="text-lg font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
              <span class="material-symbols-outlined text-blue-600">mail</span>
              <span>{locale === 'th' ? 'ช่องทางอีเมลติดต่อ' : 'Email Channels'}</span>
            </h2>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
              {locale === 'th'
                ? 'โปรดระบุชื่อเครื่องมือ ปัญหาที่พบ หรือข้อเสนอแนะ ทางทีมงานจะติดต่อกลับโดยเร็วที่สุด:'
                : 'Please specify the tool name, steps to reproduce, or your inquiry:'}
            </p>
            <div class="mt-4 flex flex-wrap gap-3">
              <a
                class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-blue-600 px-5 font-bold text-white hover:bg-blue-700 transition"
                href="mailto:kris.p.pop@gmail.com"
              >
                <span class="material-symbols-outlined text-[18px]">send</span>
                <span>kris.p.pop@gmail.com</span>
              </a>
              <a
                class="inline-flex min-h-11 items-center gap-2 rounded-xl border border-slate-300 dark:border-slate-700 px-5 font-bold text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition"
                href="mailto:stackwise@fintechxhub.com"
              >
                <span class="material-symbols-outlined text-[18px]">alternate_email</span>
                <span>stackwise@fintechxhub.com</span>
              </a>
            </div>
          </div>
        )
      }
    </div>
    <div class="mt-12">
      <AdSlot locale={locale} slotId={AD_SLOT_IDS.inContent} placement="in-content" />
    </div>
  </article>
</BaseLayout>
