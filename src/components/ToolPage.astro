---
import AdSlot from './AdSlot.astro';
import BaseLayout from './BaseLayout.astro';
import ToolCard from './ToolCard.astro';
import { AD_SLOT_IDS, SITE } from '../config/site';
import { getRelatedTools, type ToolConfig } from '../config/registry';
import { messages, type Locale } from '../i18n';

interface Props {
  tool: ToolConfig;
  locale: Locale;
}

const { tool, locale } = Astro.props;
const t = messages[locale];
const Component = tool.component;
const path = locale === 'th' ? `/tools/${tool.slug}/` : `/en/tools/${tool.slug}/`;
const categoryName = tool.category === 'generators' ? t.generators : t.converters;
const categoryPath =
  locale === 'th' ? `/category/${tool.category}/` : `/en/category/${tool.category}/`;
const related = getRelatedTools(tool);
const description = tool.description[locale];
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: t.siteName,
      item: `${SITE.url}${locale === 'th' ? '/' : '/en/'}`
    },
    { '@type': 'ListItem', position: 2, name: categoryName, item: `${SITE.url}${categoryPath}` },
    { '@type': 'ListItem', position: 3, name: tool.name[locale], item: `${SITE.url}${path}` }
  ]
};
const applicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `${SITE.url}${path}#app`,
  name: tool.name[locale],
  url: `${SITE.url}${path}`,
  description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  inLanguage: locale === 'th' ? 'th' : 'en',
  isAccessibleForFree: true
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tool.faqs[locale].map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer }
  }))
};
---

<BaseLayout
  locale={locale}
  title={`${tool.name[locale]} | ${t.siteName}`}
  description={description}
  path={path}
  jsonLd={[applicationSchema, breadcrumbSchema, faqSchema]}
>
  <div class="container-shell py-8 sm:py-12">
    <nav class="text-sm text-slate-500 dark:text-slate-400" aria-label="Breadcrumb">
      <a class="hover:text-blue-600 dark:hover:text-blue-300" href={locale === 'th' ? '/' : '/en/'}
        >{t.siteName}</a
      ><span class="mx-2" aria-hidden="true">/</span><a
        class="hover:text-blue-600 dark:hover:text-blue-300"
        href={categoryPath}>{categoryName}</a
      ><span class="mx-2" aria-hidden="true">/</span><span aria-current="page"
        >{tool.name[locale]}</span
      >
    </nav>
    <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start">
      <div>
        <header class="max-w-4xl">
          <div class="flex flex-wrap items-center gap-2">
            <span
              class="rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700 dark:bg-blue-950/60 dark:text-blue-300"
              >{categoryName}</span
            ><span
              class="inline-flex min-h-8 items-center gap-1.5 rounded-full bg-emerald-50 px-3 text-xs font-bold text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300"
              ><span class="size-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>{
                t.localOnly
              }</span
            >
          </div>
          <h1
            class="mt-4 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl dark:text-white"
          >
            {tool.name[locale]}
          </h1>
          <p class="mt-4 text-lg leading-8 text-slate-600 dark:text-slate-300">
            {tool.shortDescription[locale]}
          </p>
          <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
            {t.latest}: <time datetime={tool.updatedAt}>{tool.updatedAt}</time>
          </p>
        </header>
        <div class="mt-8"><Component locale={locale} /></div>
        <div><AdSlot locale={locale} slotId={AD_SLOT_IDS.belowTool} placement="below-tool" /></div>
        <section class="mt-10" aria-labelledby="how-to-heading">
          <h2 id="how-to-heading" class="text-2xl font-black text-slate-950 dark:text-white">
            {t.howTo}
          </h2>
          <ol class="mt-5 grid gap-3">
            {
              tool.howTo[locale].map((step, index) => (
                <li class="flex gap-3 rounded-xl border border-slate-200 bg-white/60 p-4 dark:border-slate-700 dark:bg-slate-900/60">
                  <>
                    <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-blue-100 text-sm font-black text-blue-700 dark:bg-blue-950 dark:text-blue-300">
                      {index + 1}
                    </span>
                    <span class="pt-1 text-sm leading-6 text-slate-700 dark:text-slate-200">
                      {step}
                    </span>
                  </>
                </li>
              ))
            }
          </ol>
        </section>
        <section
          class="prose-copy mt-10 max-w-3xl text-slate-700 dark:text-slate-200"
          aria-labelledby="explanation-heading"
        >
          <h2 id="explanation-heading" class="text-2xl font-black text-slate-950 dark:text-white">
            {t.explanation}
          </h2>
          {tool.longDescription[locale].map((paragraph) => <p>{paragraph}</p>)}
        </section>
        <div><AdSlot locale={locale} slotId={AD_SLOT_IDS.inContent} placement="in-content" /></div>
        <section class="mt-10" aria-labelledby="faq-heading">
          <h2 id="faq-heading" class="text-2xl font-black text-slate-950 dark:text-white">
            {t.faq}
          </h2>
          <div class="mt-5 grid gap-3">
            {
              tool.faqs[locale].map((faq) => (
                <details class="group rounded-xl border border-slate-200 bg-white/70 p-4 dark:border-slate-700 dark:bg-slate-900/70">
                  <>
                    <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 font-bold text-slate-900 dark:text-white">
                      <>
                        <span>{faq.question}</span>
                        <span
                          class="text-xl text-blue-600 transition group-open:rotate-45 dark:text-blue-300"
                          aria-hidden="true"
                        >
                          +
                        </span>
                      </>
                    </summary>
                    <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-600 dark:text-slate-300">
                      {faq.answer}
                    </p>
                  </>
                </details>
              ))
            }
          </div>
        </section>
        <section class="mt-12" aria-labelledby="related-heading">
          <div class="flex items-end justify-between gap-4">
            <div>
              <p
                class="text-sm font-bold uppercase tracking-[0.16em] text-blue-600 dark:text-blue-300"
              >
                ToolXHub
              </p><h2
                id="related-heading"
                class="mt-2 text-2xl font-black text-slate-950 dark:text-white"
              >
                {t.relatedTools}
              </h2>
            </div><a
              class="hidden min-h-11 items-center text-sm font-bold text-blue-600 hover:underline dark:text-blue-300 sm:inline-flex"
              href={categoryPath}>{categoryName} →</a
            >
          </div>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            {related.map((relatedTool) => <ToolCard tool={relatedTool} locale={locale} />)}
          </div>
        </section>
      </div>
      <aside class="hidden lg:block" aria-label={t.adsLabel}>
        <div class="sticky top-24">
          <AdSlot locale={locale} slotId={AD_SLOT_IDS.sidebar} placement="sidebar" />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
