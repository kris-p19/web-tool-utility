---
import { SITE } from '../config/site';
import { messages, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
const path = (name: string) => (locale === 'th' ? `/${name}/` : `/en/${name}/`);
---

<footer class="mt-16 border-t border-slate-200/80 dark:border-slate-700/70">
  <div class="container-shell grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <a
        href={locale === 'th' ? '/' : '/en/'}
        class="flex items-center gap-2 text-lg font-extrabold text-slate-900 dark:text-white"
      >
        <span
          class="grid size-9 place-items-center rounded-xl bg-blue-600 text-sm font-extrabold text-white"
          aria-hidden="true">TX</span
        >
        <span>{SITE.name}</span>
      </a>
      <p class="mt-4 max-w-sm text-sm leading-7 text-slate-600 dark:text-slate-300">
        {t.description}
      </p>
      <p
        class="mt-3 inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300"
      >
        <span class="size-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
        {t.localOnly}
      </p>
    </div>
    <div>
      <h2 class="text-sm font-extrabold text-slate-900 dark:text-white">{t.allTools}</h2>
      <ul class="mt-4 grid gap-2 text-sm text-slate-600 dark:text-slate-300">
        <li>
          <a
            class="inline-flex min-h-9 items-center hover:text-blue-600 dark:hover:text-blue-300"
            href={path('category/generators')}>{t.generators}</a
          >
        </li>
        <li>
          <a
            class="inline-flex min-h-9 items-center hover:text-blue-600 dark:hover:text-blue-300"
            href={path('category/converters')}>{t.converters}</a
          >
        </li>
        <li>
          <a
            class="inline-flex min-h-9 items-center hover:text-blue-600 dark:hover:text-blue-300"
            href={locale === 'th' ? '/tools/qr-code/' : '/en/tools/qr-code/'}>{t.popularTools}</a
          >
        </li>
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-extrabold text-slate-900 dark:text-white">{t.about}</h2>
      <ul class="mt-4 grid gap-2 text-sm text-slate-600 dark:text-slate-300">
        <li>
          <a
            class="inline-flex min-h-9 items-center hover:text-blue-600 dark:hover:text-blue-300"
            href={path('about')}>{t.about}</a
          >
        </li>
        <li>
          <a
            class="inline-flex min-h-9 items-center hover:text-blue-600 dark:hover:text-blue-300"
            href={path('contact')}>{t.contact}</a
          >
        </li>
        <li>
          <a
            class="inline-flex min-h-9 items-center hover:text-blue-600 dark:hover:text-blue-300"
            href={path('privacy-policy')}>{t.privacy}</a
          >
        </li>
        <li>
          <a
            class="inline-flex min-h-9 items-center hover:text-blue-600 dark:hover:text-blue-300"
            href={path('terms')}>{t.terms}</a
          >
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-slate-200/80 dark:border-slate-700/70">
    <div
      class="container-shell flex flex-col gap-3 py-5 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between dark:text-slate-400"
    >
      <p>© {new Date().getFullYear()} {SITE.name}. {t.footerNote}.</p>
      <a
        class="inline-flex min-h-9 items-center gap-1 font-bold text-blue-600 hover:underline dark:text-blue-300"
        href={SITE.parentUrl}
        rel="noopener"
      >
        {t.parentSite}
        <span class="material-symbols-outlined text-[14px]">open_in_new</span>
      </a>
    </div>
  </div>
</footer>
