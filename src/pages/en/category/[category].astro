---
import CategoryPage from '../../../components/CategoryPage.astro';
import { type ToolCategory } from '../../../config/registry';
import { type Locale } from '../../../i18n';

export function getStaticPaths() {
  const categories: ToolCategory[] = ['generators', 'converters'];
  return categories.map((category) => ({
    params: { category },
    props: { category, locale: 'en' as Locale }
  }));
}

const { category, locale } = Astro.props as { category: ToolCategory; locale: Locale };
---

<CategoryPage category={category} locale={locale} />
