---
import CategoryPage from '../../../components/CategoryPage.astro';
import { toolCategories, type ToolCategory } from '../../../config/tools';
import { type Locale } from '../../../i18n';

export function getStaticPaths() {
  return toolCategories.map((category) => ({
    params: { category },
    props: { category, locale: 'en' as Locale }
  }));
}

const { category, locale } = Astro.props as { category: ToolCategory; locale: Locale };
---

<CategoryPage category={category} locale={locale} />