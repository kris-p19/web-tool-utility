---
import BaseLayout from '../components/BaseLayout.astro';
import { messages } from '../i18n';

const t = messages.th;
---

<BaseLayout
  locale="th"
  title={`ไม่พบหน้านี้ | ${t.siteName}`}
  description="ไม่พบหน้าที่คุณกำลังค้นหา"
  path="/404/"
  noindex
>
  <section class="container-shell grid min-h-[60vh] place-items-center py-20 text-center">
    <div>
      <p class="text-sm font-black uppercase tracking-[0.2em] text-blue-600 dark:text-blue-300">
        404
      </p>
      <h1 class="mt-4 text-4xl font-black text-slate-950 dark:text-white">ไม่พบหน้านี้</h1>
      <p class="mx-auto mt-4 max-w-md text-slate-600 dark:text-slate-300">
        หน้าที่คุณกำลังค้นหาอาจถูกย้ายหรือไม่มีอยู่แล้ว
      </p>
      <a class="btn btn-primary mt-8" href="/">{t.backHome}</a>
    </div>
  </section>
</BaseLayout>
